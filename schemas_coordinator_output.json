{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/reporting-agent/coordinator-output.schema.json",
  "title": "Coordinator Agent Output - Reporting Agent Input",
  "description": "Canonical input contract recommended for the Coordinator Agent. The Reporting Agent also accepts common aliases documented in docs/INPUT_OUTPUT_CONTRACT.md.",
  "type": "object",
  "required": ["project_id", "run_id", "findings"],
  "properties": {
    "schema_version": {"type": "string", "default": "1.0.0"},
    "project_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "description": "Coordinator execution status, e.g. COMPLETED, PARTIAL, FAILED"},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "issue_id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"enum": ["VIOLATION", "REVIEW", "COMPLIANT"]},
          "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "source_module": {"type": "string"},
          "target_module": {"type": "string"},
          "dependency_type": {"type": "string"},
          "rule_id": {"type": "string"},
          "rule_description": {"type": "string"},
          "description": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_path": {"type": "string"},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "symbol": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          },
          "unresolved_items": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recommendation_id": {"type": "string"},
          "related_finding_ids": {"type": "array", "items": {"type": "string"}},
          "related_finding_id": {"type": "string"},
          "title": {"type": "string"},
          "priority": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]},
          "description": {"type": "string"},
          "recommended_action": {
            "oneOf": [
              {"type": "string"},
              {"type": "object", "properties": {"approach": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}}}}
            ]
          },
          "expected_benefit": {"type": "string"},
          "risks": {"type": "array", "items": {"type": "string"}},
          "requires_human_review": {"type": "boolean"}
        }
      }
    },
    "unresolved_items": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
